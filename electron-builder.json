{
  "appId": "com.newxau.desktop",
  "productName": "NEWXAU",
  "directories": {
    "output": "release"
  },
  "files": [
    "out/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "desktop/runtime/python",
      "to": "python",
      "filter": ["**/*"]
    },
    {
      "from": "src",
      "to": "backend/src",
      "filter": ["**/*"]
    },
    {
      "from": "scripts",
      "to": "backend/scripts",
      "filter": ["**/*"]
    },
    {
      "from": "models",
      "to": "backend/models",
      "filter": ["**/*"]
    },
    {
      "from": "db",
      "to": "backend/db",
      "filter": ["**/*"]
    }
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
